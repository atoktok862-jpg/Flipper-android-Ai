<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#241A0C" android:endColor="#0B0703" android:angle="270" />
            <corners android:radius="18dp" />
            <stroke android:color="#7A5218" android:width="2dp" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B0905" />
            <corners android:radius="10dp" />
            <stroke android:color="#3A2B18" android:width="1dp" />
        </shape>
    </item>
</layer-list>
