<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#343538" android:endColor="#151617" android:angle="270" />
            <corners android:radius="18dp" />
            <stroke android:color="#FFD400" android:width="2dp" />
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B120C" />
            <corners android:radius="10dp" />
            <stroke android:color="#A6D08A" android:width="1dp" />
        </shape>
    </item>
    <item android:gravity="top|left" android:top="4dp" android:left="4dp" android:width="5dp" android:height="5dp">
        <shape android:shape="oval">
            <solid android:color="#8A8A8A" />
        </shape>
    </item>
    <item android:gravity="top|right" android:top="4dp" android:right="4dp" android:width="5dp" android:height="5dp">
        <shape android:shape="oval">
            <solid android:color="#8A8A8A" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:bottom="4dp" android:left="4dp" android:width="5dp" android:height="5dp">
        <shape android:shape="oval">
            <solid android:color="#8A8A8A" />
        </shape>
    </item>
    <item android:gravity="bottom|right" android:bottom="4dp" android:right="4dp" android:width="5dp" android:height="5dp">
        <shape android:shape="oval">
            <solid android:color="#8A8A8A" />
        </shape>
    </item>
</layer-list>
