<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#5A4A00" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FFF7B0" android:endColor="#D6B400" android:angle="270" />
                    <corners android:radius="10dp" />
                    <stroke android:color="#FFFFFF" android:width="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#665400" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FFE44D" android:endColor="#C1A000" android:angle="270" />
                    <corners android:radius="10dp" />
                    <stroke android:color="#FFF3A6" android:width="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
