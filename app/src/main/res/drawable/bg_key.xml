<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0E0E0F" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="0dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FFF05A" android:endColor="#B89A00" android:angle="270" />
                    <corners android:radius="9dp" />
                    <stroke android:color="#FFE680" android:width="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#0B0B0C" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FFD400" android:endColor="#8C7400" android:angle="270" />
                    <corners android:radius="9dp" />
                    <stroke android:color="#FFE680" android:width="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
