<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#D6B400" android:endColor="#7A6600" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:color="#FFE680" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#A88B00" android:endColor="#4F4100" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:color="#FFD400" android:width="1dp" />
        </shape>
    </item>
</selector>
