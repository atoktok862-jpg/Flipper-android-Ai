<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#4A3822" android:endColor="#241708" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:color="#FFB347" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#332513" android:endColor="#160E05" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:color="#7A5218" android:width="1dp" />
        </shape>
    </item>
</selector>
